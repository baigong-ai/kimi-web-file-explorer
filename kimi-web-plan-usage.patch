@@ -0,0 +1,147 @@
+<!-- apps/kimi-web/src/components/chat/PlanUsagePill.vue -->
+<!-- Managed-plan quota pill for the composer toolbar center: 5-hour window
+     and weekly usage as `pct%（5h） / pct%（1w）`, each with a mini bar.
+     ≥80% turns warning color, ≥95% danger. Click refreshes; details and
+     reset countdowns live in the tooltip. Hides itself entirely when the
+     account is not a managed plan (composable reports unavailable). -->
+<script setup lang="ts">
+import { computed } from 'vue';
+import { useI18n } from 'vue-i18n';
+import Tooltip from '../ui/Tooltip.vue';
+import { usePlanUsage } from '../../composables/usePlanUsage';
+import type { PlanUsageRow } from '../../api/types';
+
+const { t } = useI18n();
+const { fiveHour, weekly, available, refresh } = usePlanUsage();
+
+function pctOf(row: PlanUsageRow | null): number | null {
+  if (!row || row.limit <= 0) return null;
+  return Math.min(100, Math.round((row.used / row.limit) * 100));
+}
+
+const pct5 = computed(() => pctOf(fiveHour.value));
+const pct1w = computed(() => pctOf(weekly.value));
+
+function level(pct: number | null): '' | 'warn' | 'crit' {
+  if (pct === null) return '';
+  if (pct >= 95) return 'crit';
+  if (pct >= 80) return 'warn';
+  return '';
+}
+
+// "3d 4h" / "2h 15m" / "40m" until the window resets.
+function resetCountdown(iso: string | undefined): string {
+  if (!iso) return '';
+  const ms = new Date(iso).getTime() - Date.now();
+  if (!Number.isFinite(ms) || ms <= 0) return '';
+  const mins = Math.round(ms / 60000);
+  const d = Math.floor(mins / 1440);
+  const h = Math.floor((mins % 1440) / 60);
+  const m = mins % 60;
+  if (d > 0) return `${d}d ${h}h`;
+  if (h > 0) return `${h}h ${m}m`;
+  return `${m}m`;
+}
+
+function tooltipRow(labelKey: string, row: PlanUsageRow | null): string | null {
+  if (!row) return null;
+  const base = `${t(labelKey)} ${row.used}/${row.limit}`;
+  const cd = resetCountdown(row.resetAt);
+  return cd ? `${base} · ${t('planUsage.resetIn', { time: cd })}` : base;
+}
+
+const tooltip = computed(() =>
+  [
+    tooltipRow('planUsage.fiveHour', fiveHour.value),
+    tooltipRow('planUsage.weekly', weekly.value),
+    t('planUsage.refreshHint'),
+  ]
+    .filter(Boolean)
+    .join(' · '),
+);
+</script>
+
+<template>
+  <Tooltip v-if="available && (pct5 !== null || pct1w !== null)" :text="tooltip" :max-width="360">
+    <button type="button" class="usage-pill" @click="refresh">
+      <span v-if="pct5 !== null" class="u-seg">
+        <span class="u-bar"><span class="u-fill" :class="level(pct5)" :style="{ width: pct5 + '%' }" /></span>
+        <span class="u-num" :class="level(pct5)">{{ t('planUsage.seg', { pct: pct5, win: '5h' }) }}</span>
+      </span>
+      <span v-if="pct5 !== null && pct1w !== null" class="u-sep">/</span>
+      <span v-if="pct1w !== null" class="u-seg">
+        <span class="u-bar"><span class="u-fill" :class="level(pct1w)" :style="{ width: pct1w + '%' }" /></span>
+        <span class="u-num" :class="level(pct1w)">{{ t('planUsage.seg', { pct: pct1w, win: '1w' }) }}</span>
+      </span>
+    </button>
+  </Tooltip>
+</template>
+
+<style scoped>
+.usage-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 2px 7px;
+  border: none;
+  border-radius: 6px;
+  background: transparent;
+  font-size: var(--ui-font-size);
+  line-height: var(--leading-normal);
+  font-family: var(--font-ui);
+  font-weight: var(--weight-medium);
+  color: var(--dim);
+  cursor: pointer;
+  user-select: none;
+  transition: background 0.1s;
+  white-space: nowrap;
+}
+.usage-pill:hover {
+  background: var(--color-surface-sunken);
+}
+
+.u-seg {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
+.u-bar {
+  width: 26px;
+  height: 4px;
+  border-radius: var(--radius-full);
+  background: var(--color-line);
+  overflow: hidden;
+}
+.u-fill {
+  display: block;
+  height: 100%;
+  border-radius: var(--radius-full);
+  background: var(--color-text-faint);
+  transition: width 0.3s;
+}
+.u-fill.warn {
+  background: var(--color-warning);
+}
+.u-fill.crit {
+  background: var(--color-danger);
+}
+.u-num {
+  font-variant-numeric: tabular-nums;
+}
+.u-num.warn {
+  color: var(--color-warning);
+}
+.u-num.crit {
+  color: var(--color-danger);
+}
+.u-sep {
+  color: var(--faint);
+}
+
+/* Narrow columns: drop the mini bars first, keep the numbers. */
+@media (max-width: 980px) {
+  .u-bar {
+    display: none;
+  }
+}
+</style>
diff --git a/apps/kimi-web/src/composables/usePlanUsage.ts b/apps/kimi-web/src/composables/usePlanUsage.ts
new file mode 100644
index 0000000..5ddbd37
--- /dev/null
+++ b/apps/kimi-web/src/composables/usePlanUsage.ts
@@ -0,0 +1,56 @@
+// apps/kimi-web/src/composables/usePlanUsage.ts
+// Managed-account plan usage (5-hour window + weekly quota) for the composer
+// toolbar pill. Module-level singleton: one poller shared by all consumers,
+// refreshed every 60 s and whenever the tab regains focus. Unavailable
+// (non-managed account, server without the endpoint) → `available` stays
+// false and the pill hides itself.
+import { ref } from 'vue';
+import { getKimiWebApi } from '../api';
+import type { PlanUsageRow } from '../api/types';
+
+const POLL_MS = 60_000;
+
+const fiveHour = ref<PlanUsageRow | null>(null);
+const weekly = ref<PlanUsageRow | null>(null);
+const available = ref(false);
+const loading = ref(false);
+
+let started = false;
+
+async function refresh(): Promise<void> {
+  if (loading.value) return;
+  loading.value = true;
+  try {
+    const result = await getKimiWebApi().getManagedUsage();
+    if (result.kind !== 'ok') {
+      available.value = false;
+      return;
+    }
+    fiveHour.value =
+      result.limits.find((r) => r.window?.duration === 5 && r.window.unit === 'hour') ?? null;
+    weekly.value = result.summary;
+    available.value = fiveHour.value !== null || weekly.value !== null;
+  } catch {
+    // Endpoint missing or auth not managed — treat as unavailable, keep polling.
+    available.value = false;
+  } finally {
+    loading.value = false;
+  }
+}
+
+function onVisible(): void {
+  if (!document.hidden) void refresh();
+}
+
+function start(): void {
+  if (started) return;
+  started = true;
+  void refresh();
+  setInterval(() => void refresh(), POLL_MS);
+  document.addEventListener('visibilitychange', onVisible);
+}
+
+export function usePlanUsage() {
+  start();
+  return { fiveHour, weekly, available, loading, refresh };
+}
