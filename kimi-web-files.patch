diff --git a/apps/kimi-web/src/composables/useFileTree.ts b/apps/kimi-web/src/composables/useFileTree.ts
new file mode 100644
index 00000000..ba6da4f9
--- /dev/null
+++ b/apps/kimi-web/src/composables/useFileTree.ts
@@ -0,0 +1,255 @@
+// apps/kimi-web/src/composables/useFileTree.ts
+// Workspace file tree backing the right-side 'files' detail panel: lazy
+// directory loading via client.listDir (workspace-relative paths), a name
+// filter over the already-loaded nodes, and file loading for the embedded
+// FilePreview. State is session-scoped — switching sessions wipes it.
+
+import { computed, ref, watch } from 'vue';
+import type { FileData } from '../types';
+import type { FsEntry } from '../api/types';
+import type { useKimiWebClient } from './useKimiWebClient';
+
+type KimiWebClient = ReturnType<typeof useKimiWebClient>;
+
+/** A flattened tree row: the entry plus its nesting depth for indentation. */
+export interface FileTreeRow {
+  entry: FsEntry;
+  depth: number;
+}
+
+function isDir(entry: FsEntry): boolean {
+  return entry.kind === 'directory';
+}
+
+export { isDir as isDirEntry };
+
+function sortEntries(entries: FsEntry[]): FsEntry[] {
+  return entries.toSorted((a, b) => {
+    if (isDir(a) !== isDir(b)) return isDir(a) ? -1 : 1;
+    return a.name.localeCompare(b.name);
+  });
+}
+
+export function useFileTree({ client }: { client: KimiWebClient }) {
+  // Directory listing cache: '' is the workspace root; keys are
+  // workspace-relative directory paths as reported by fs:list.
+  const childrenByPath = ref<Record<string, FsEntry[]>>({});
+  const expanded = ref<Record<string, boolean>>({});
+  const loadingDirs = ref<Record<string, boolean>>({});
+  const rootLoaded = ref(false);
+  const dirError = ref<string | null>(null);
+
+  const filter = ref('');
+
+  // Whether dotfiles are listed. Server-side fs:list defaults show_hidden to
+  // false; toggling re-fetches every loaded directory.
+  const showHidden = ref(false);
+
+  // Embedded file preview state (a seq guard keeps a slow earlier read from
+  // overwriting a later one). `activeFilePath` tracks the selected row even
+  // while its content is still loading.
+  const activeFile = ref<FileData | null>(null);
+  const activeFilePath = ref<string | null>(null);
+  const activeFileLine = ref<number | undefined>(undefined);
+  const fileLoading = ref(false);
+  const fileError = ref<string | null>(null);
+  let fileRequestSeq = 0;
+
+  const cwd = computed(() => client.status.value.cwd);
+  const hasSession = computed(() => client.activeSessionId.value !== null);
+
+  async function loadDir(path: string): Promise<void> {
+    if (!hasSession.value) return;
+    if (loadingDirs.value[path]) return;
+    loadingDirs.value = { ...loadingDirs.value, [path]: true };
+    dirError.value = null;
+    try {
+      const items = await client.listDir(path === '' ? '.' : path, { showHidden: showHidden.value });
+      childrenByPath.value = { ...childrenByPath.value, [path]: sortEntries(items) };
+      if (path === '') rootLoaded.value = true;
+    } catch {
+      // listDir already swallows daemon errors into [], so reaching here means
+      // something unexpected — surface it as a panel-level error.
+      dirError.value = path;
+    } finally {
+      const next = { ...loadingDirs.value };
+      delete next[path];
+      loadingDirs.value = next;
+    }
+  }
+
+  /** Load the workspace root once (idempotent). Called when the panel opens. */
+  async function ensureRoot(): Promise<void> {
+    if (rootLoaded.value || !hasSession.value) return;
+    await loadDir('');
+  }
+
+  async function toggleDir(entry: FsEntry): Promise<void> {
+    if (!isDir(entry)) return;
+    if (expanded.value[entry.path]) {
+      const next = { ...expanded.value };
+      delete next[entry.path];
+      expanded.value = next;
+      return;
+    }
+    expanded.value = { ...expanded.value, [entry.path]: true };
+    if (!(entry.path in childrenByPath.value)) await loadDir(entry.path);
+  }
+
+  /** Re-fetch the root and every expanded directory, keeping expansion state. */
+  async function refresh(): Promise<void> {
+    if (!hasSession.value) return;
+    const openDirs = Object.keys(expanded.value);
+    rootLoaded.value = false;
+    childrenByPath.value = {};
+    await loadDir('');
+    await Promise.all(openDirs.map((path) => loadDir(path)));
+  }
+
+  /** Flip dotfile visibility and reload the tree with the new setting. */
+  async function toggleShowHidden(): Promise<void> {
+    showHidden.value = !showHidden.value;
+    await refresh();
+  }
+
+  // Rendered rows. With an empty filter this is the flattened expanded tree;
+  // with a filter it is a flat list of matching entries across every loaded
+  // directory (depth 0, parent path shown by the component).
+  const rows = computed<FileTreeRow[]>(() => {
+    const query = filter.value.trim().toLowerCase();
+    if (query) {
+      const matches: FileTreeRow[] = [];
+      for (const entries of Object.values(childrenByPath.value)) {
+        for (const entry of entries) {
+          if (entry.name.toLowerCase().includes(query)) matches.push({ entry, depth: 0 });
+        }
+      }
+      return matches.toSorted((a, b) => a.entry.path.localeCompare(b.entry.path));
+    }
+    const out: FileTreeRow[] = [];
+    const walk = (entries: FsEntry[], depth: number): void => {
+      for (const entry of entries) {
+        out.push({ entry, depth });
+        if (isDir(entry) && expanded.value[entry.path]) {
+          walk(childrenByPath.value[entry.path] ?? [], depth + 1);
+        }
+      }
+    };
+    walk(childrenByPath.value[''] ?? [], 0);
+    return out;
+  });
+
+  const rootLoading = computed(() => loadingDirs.value[''] === true);
+  const rootEmpty = computed(
+    () => rootLoaded.value && (childrenByPath.value[''] ?? []).length === 0,
+  );
+
+  function parentPath(path: string): string {
+    const idx = path.lastIndexOf('/');
+    return idx === -1 ? '' : path.slice(0, idx);
+  }
+
+  async function openPath(path: string, line?: number): Promise<void> {
+    const seq = ++fileRequestSeq;
+    activeFile.value = null;
+    activeFilePath.value = path;
+    activeFileLine.value = line;
+    fileError.value = null;
+    fileLoading.value = true;
+    try {
+      const result = await client.readFileContent(path);
+      if (seq !== fileRequestSeq) return;
+      if (result) {
+        activeFile.value = { ...result, path: result.path || path };
+      } else {
+        fileError.value = path;
+      }
+    } finally {
+      if (seq === fileRequestSeq) fileLoading.value = false;
+    }
+  }
+
+  function openEntry(entry: FsEntry): void {
+    if (isDir(entry)) {
+      void toggleDir(entry);
+      return;
+    }
+    void openPath(entry.path);
+  }
+
+  function backToTree(): void {
+    fileRequestSeq += 1;
+    activeFile.value = null;
+    activeFilePath.value = null;
+    activeFileLine.value = undefined;
+    fileError.value = null;
+    fileLoading.value = false;
+  }
+
+  const downloadUrl = computed(() => {
+    const path = activeFilePath.value;
+    return path ? client.getFileDownloadUrl(path) : null;
+  });
+
+  function openActiveInEditor(): void {
+    const path = activeFilePath.value;
+    if (path) void client.openWorkspaceFile(path, activeFileLine.value);
+  }
+
+  function revealActive(): void {
+    const path = activeFilePath.value;
+    if (path) void client.revealWorkspaceFile(path);
+  }
+
+  function reset(): void {
+    fileRequestSeq += 1;
+    childrenByPath.value = {};
+    expanded.value = {};
+    loadingDirs.value = {};
+    rootLoaded.value = false;
+    dirError.value = null;
+    filter.value = '';
+    showHidden.value = false;
+    activeFile.value = null;
+    activeFilePath.value = null;
+    activeFileLine.value = undefined;
+    fileLoading.value = false;
+    fileError.value = null;
+  }
+
+  watch(client.activeSessionId, () => {
+    reset();
+  });
+
+  return {
+    cwd,
+    hasSession,
+    rows,
+    expanded,
+    loadingDirs,
+    rootLoaded,
+    rootLoading,
+    rootEmpty,
+    dirError,
+    filter,
+    showHidden,
+    activeFile,
+    activeFilePath,
+    activeFileLine,
+    fileLoading,
+    fileError,
+    downloadUrl,
+    ensureRoot,
+    toggleDir,
+    refresh,
+    toggleShowHidden,
+    openEntry,
+    openPath,
+    backToTree,
+    parentPath,
+    openActiveInEditor,
+    revealActive,
+  };
+}
+
+export type FileTree = ReturnType<typeof useFileTree>;
