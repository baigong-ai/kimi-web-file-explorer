+<!-- apps/kimi-web/src/components/FileTreePanel.vue -->
+<!-- Workspace file browser in the right-side detail layer ('files' slot):
+     lazy-loaded directory tree with a name filter; clicking a file swaps the
+     tree for the shared FilePreview inside the same panel (back bar returns).
+     All state lives in the useFileTree composable (App scope), so closing and
+     reopening the panel keeps the tree as it was. -->
+<script setup lang="ts">
+import { onMounted, watch } from 'vue';
+import { useI18n } from 'vue-i18n';
+import FilePreview from './FilePreview.vue';
+import Icon from './ui/Icon.vue';
+import IconButton from './ui/IconButton.vue';
+import PanelHeader from './ui/PanelHeader.vue';
+import Tooltip from './ui/Tooltip.vue';
+import { isDirEntry, type FileTree } from '../composables/useFileTree';
+import type { FilePreviewRequest } from '../types';
+
+const props = defineProps<{
+  tree: FileTree;
+}>();
+
+const emit = defineEmits<{
+  close: [];
+}>();
+
+const { t } = useI18n();
+
+// Destructured refs stay reactive in the template (they are top-level here).
+const {
+  cwd,
+  hasSession,
+  rows,
+  expanded,
+  loadingDirs,
+  rootLoaded,
+  rootLoading,
+  dirError,
+  filter,
+  activeFile,
+  activeFilePath,
+  activeFileLine,
+  fileLoading,
+  fileError,
+  downloadUrl,
+} = props.tree;
+
+onMounted(() => {
+  void props.tree.ensureRoot();
+});
+// The panel can open before any session exists (empty composer); load the
+// root as soon as one appears.
+watch(hasSession, (has) => {
+  if (has) void props.tree.ensureRoot();
+});
+
+function handleMarkdownOpenFile(target: FilePreviewRequest): void {
+  void props.tree.openPath(target.path, target.line);
+}
+</script>
+
+<template>
+  <div class="ft">
+    <PanelHeader
+      :title="t('fileTree.title')"
+      :subtitle="cwd"
+      :close-label="t('fileTree.close')"
+      @close="emit('close')"
+    >
+      <Tooltip :text="t('fileTree.refresh')">
+        <IconButton
+          size="sm"
+          :label="t('fileTree.refresh')"
+          :disabled="!hasSession"
+          @click="tree.refresh()"
+        >
+          <Icon name="refresh" size="sm" />
+        </IconButton>
+      </Tooltip>
+    </PanelHeader>
+
+    <!-- No session yet: fs routes are session-scoped, so nothing to list. -->
+    <div v-if="!hasSession" class="ft-empty">{{ t('fileTree.noSession') }}</div>
+
+    <!-- File view: shared FilePreview with a back bar instead of a close. -->
+    <template v-else-if="activeFilePath">
+      <div class="ft-backbar">
+        <button type="button" class="ft-back" @click="tree.backToTree()">
+          <Icon name="chevron-right" size="sm" class="ft-back-icon" />
+          <span>{{ t('fileTree.back') }}</span>
+        </button>
+        <Tooltip :text="activeFilePath">
+          <span class="ft-backpath">{{ activeFilePath }}</span>
+        </Tooltip>
+      </div>
+      <div class="ft-file">
+        <FilePreview
+          :file="activeFile"
+          :loading="fileLoading"
+          :error="fileError ? t('fileTree.loadFileFailed') : null"
+          :line="activeFileLine"
+          :download-url="downloadUrl"
+          external-actions
+          :open-file="handleMarkdownOpenFile"
+          @open-external="tree.openActiveInEditor()"
+          @reveal="tree.revealActive()"
+        />
+      </div>
+    </template>
+
+    <!-- Tree view -->
+    <template v-else>
+      <div class="ft-find">
+        <Icon name="search" size="sm" class="ft-find-icon" />
+        <input
+          v-model="filter"
+          class="ft-find-input"
+          type="text"
+          :placeholder="t('fileTree.findPlaceholder')"
+        />
+      </div>
+      <div class="ft-body">
+        <div v-if="dirError" class="ft-empty">{{ t('fileTree.loadDirFailed') }}</div>
+        <div v-else-if="!rootLoaded && rootLoading" class="ft-empty">
+          <span class="spinner" />
+          {{ t('fileTree.loading') }}
+        </div>
+        <div v-else-if="rows.length === 0" class="ft-empty">{{ t('fileTree.empty') }}</div>
+        <template v-else>
+          <button
+            v-for="row in rows"
+            :key="row.entry.path"
+            type="button"
+            class="ft-row"
+            :class="{ active: row.entry.path === activeFilePath }"
+            :style="{ paddingLeft: `${10 + row.depth * 14}px` }"
+            @click="tree.openEntry(row.entry)"
+          >
+            <template v-if="isDirEntry(row.entry)">
+              <Icon
+                :name="expanded[row.entry.path] ? 'chevron-down' : 'chevron-right'"
+                size="sm"
+                class="ft-chev"
+              />
+              <Icon
+                :name="expanded[row.entry.path] ? 'folder' : 'folder-closed'"
+                size="sm"
+                class="ft-ico"
+              />
+            </template>
+            <template v-else>
+              <span class="ft-chev-space" />
+              <Icon name="file-text" size="sm" class="ft-ico" />
+            </template>
+            <span class="ft-name">{{ row.entry.name }}</span>
+            <span
+              v-if="filter && tree.parentPath(row.entry.path)"
+              class="ft-parent"
+            >
+              {{ tree.parentPath(row.entry.path) }}
+            </span>
+            <span
+              v-if="row.entry.gitStatus"
+              class="ft-git"
+              :title="row.entry.gitStatus"
+            />
+            <span v-if="loadingDirs[row.entry.path]" class="spinner ft-spin" />
+          </button>
+        </template>
+      </div>
+    </template>
+  </div>
+</template>
+
