@@ -0,0 +1,360 @@
+<!-- apps/kimi-web/src/components/FileTreePanel.vue -->
+<!-- Workspace file browser in the right-side detail layer ('files' slot):
+     lazy-loaded directory tree with a name filter; clicking a file swaps the
+     tree for the shared FilePreview inside the same panel (back bar returns).
+     All state lives in the useFileTree composable (App scope), so closing and
+     reopening the panel keeps the tree as it was. -->
+<script setup lang="ts">
+import { onMounted, watch } from 'vue';
+import { useI18n } from 'vue-i18n';
+import FilePreview from './FilePreview.vue';
+import Icon from './ui/Icon.vue';
+import IconButton from './ui/IconButton.vue';
+import PanelHeader from './ui/PanelHeader.vue';
+import Tooltip from './ui/Tooltip.vue';
+import { isDirEntry, type FileTree } from '../composables/useFileTree';
+import type { FilePreviewRequest } from '../types';
+
+const props = defineProps<{
+  tree: FileTree;
+}>();
+
+const emit = defineEmits<{
+  close: [];
+}>();
+
+const { t } = useI18n();
+
+// Destructured refs stay reactive in the template (they are top-level here).
+const {
+  cwd,
+  hasSession,
+  rows,
+  expanded,
+  loadingDirs,
+  rootLoaded,
+  rootLoading,
+  dirError,
+  filter,
+  showHidden,
+  activeFile,
+  activeFilePath,
+  activeFileLine,
+  fileLoading,
+  fileError,
+  downloadUrl,
+} = props.tree;
+
+onMounted(() => {
+  void props.tree.ensureRoot();
+});
+// The panel can open before any session exists (empty composer); load the
+// root as soon as one appears.
+watch(hasSession, (has) => {
+  if (has) void props.tree.ensureRoot();
+});
+
+function handleMarkdownOpenFile(target: FilePreviewRequest): void {
+  void props.tree.openPath(target.path, target.line);
+}
+</script>
+
+<template>
+  <div class="ft">
+    <PanelHeader
+      :title="t('fileTree.title')"
+      :subtitle="cwd"
+      :close-label="t('fileTree.close')"
+      @close="emit('close')"
+    >
+      <Tooltip :text="showHidden ? t('fileTree.hideHidden') : t('fileTree.showHidden')">
+        <IconButton
+          size="sm"
+          :label="showHidden ? t('fileTree.hideHidden') : t('fileTree.showHidden')"
+          :disabled="!hasSession"
+          :class="{ 'ft-eye-on': showHidden }"
+          @click="tree.toggleShowHidden()"
+        >
+          <Icon :name="showHidden ? 'eye' : 'eye-off'" size="sm" />
+        </IconButton>
+      </Tooltip>
+      <Tooltip :text="t('fileTree.refresh')">
+        <IconButton
+          size="sm"
+          :label="t('fileTree.refresh')"
+          :disabled="!hasSession"
+          @click="tree.refresh()"
+        >
+          <Icon name="refresh" size="sm" />
+        </IconButton>
+      </Tooltip>
+    </PanelHeader>
+
+    <!-- No session yet: fs routes are session-scoped, so nothing to list. -->
+    <div v-if="!hasSession" class="ft-empty">{{ t('fileTree.noSession') }}</div>
+
+    <!-- File view: shared FilePreview with a back bar instead of a close. -->
+    <template v-else-if="activeFilePath">
+      <div class="ft-backbar">
+        <button type="button" class="ft-back" @click="tree.backToTree()">
+          <Icon name="chevron-right" size="sm" class="ft-back-icon" />
+          <span>{{ t('fileTree.back') }}</span>
+        </button>
+        <Tooltip :text="activeFilePath">
+          <span class="ft-backpath">{{ activeFilePath }}</span>
+        </Tooltip>
+      </div>
+      <div class="ft-file">
+        <FilePreview
+          :file="activeFile"
+          :loading="fileLoading"
+          :error="fileError ? t('fileTree.loadFileFailed') : null"
+          :line="activeFileLine"
+          :download-url="downloadUrl"
+          external-actions
+          :open-file="handleMarkdownOpenFile"
+          @open-external="tree.openActiveInEditor()"
+          @reveal="tree.revealActive()"
+        />
+      </div>
+    </template>
+
+    <!-- Tree view -->
+    <template v-else>
+      <div class="ft-find">
+        <Icon name="search" size="sm" class="ft-find-icon" />
+        <input
+          v-model="filter"
+          class="ft-find-input"
+          type="text"
+          :placeholder="t('fileTree.findPlaceholder')"
+        />
+      </div>
+      <div class="ft-body">
+        <div v-if="dirError" class="ft-empty">{{ t('fileTree.loadDirFailed') }}</div>
+        <div v-else-if="!rootLoaded && rootLoading" class="ft-empty">
+          <span class="spinner" />
+          {{ t('fileTree.loading') }}
+        </div>
+        <div v-else-if="rows.length === 0" class="ft-empty">{{ t('fileTree.empty') }}</div>
+        <template v-else>
+          <button
+            v-for="row in rows"
+            :key="row.entry.path"
+            type="button"
+            class="ft-row"
+            :class="{ active: row.entry.path === activeFilePath }"
+            :style="{ paddingLeft: `${10 + row.depth * 14}px` }"
+            @click="tree.openEntry(row.entry)"
+          >
+            <template v-if="isDirEntry(row.entry)">
+              <Icon
+                :name="expanded[row.entry.path] ? 'chevron-down' : 'chevron-right'"
+                size="sm"
+                class="ft-chev"
+              />
+              <Icon
+                :name="expanded[row.entry.path] ? 'folder' : 'folder-closed'"
+                size="sm"
+                class="ft-ico"
+              />
+            </template>
+            <template v-else>
+              <span class="ft-chev-space" />
+              <Icon name="file-text" size="sm" class="ft-ico" />
+            </template>
+            <span class="ft-name">{{ row.entry.name }}</span>
+            <span
+              v-if="filter && tree.parentPath(row.entry.path)"
+              class="ft-parent"
+            >
+              {{ tree.parentPath(row.entry.path) }}
+            </span>
+            <span
+              v-if="row.entry.gitStatus"
+              class="ft-git"
+              :title="row.entry.gitStatus"
+            />
+            <span v-if="loadingDirs[row.entry.path]" class="spinner ft-spin" />
+          </button>
+        </template>
+      </div>
+    </template>
+  </div>
+</template>
+
+<style scoped>
+.ft {
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  background: var(--color-bg);
+}
+
+.ft-empty {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 20px;
+  text-align: center;
+  font: var(--text-base) var(--font-ui);
+  color: var(--color-text-muted);
+}
+
+/* Hidden-files toggle (lands on the IconButton root via class fall-through) */
+.ft-eye-on {
+  color: var(--color-text);
+  background: color-mix(in srgb, var(--color-text) 8%, transparent);
+}
+
+/* Find box ------------------------------------------------------------ */
+.ft-find {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 8px 10px;
+  padding: 0 8px;
+  height: 30px;
+  border: 1px solid var(--color-line);
+  border-radius: 6px;
+  background: var(--color-surface);
+  color: var(--color-text-muted);
+}
+.ft-find-icon {
+  flex: none;
+}
+.ft-find-input {
+  flex: 1;
+  min-width: 0;
+  border: none;
+  outline: none;
+  background: transparent;
+  font: var(--text-sm) var(--font-ui);
+  color: var(--color-text);
+}
+
+/* Tree rows ------------------------------------------------------------ */
+.ft-body {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  padding: 2px 4px 12px;
+}
+.ft-row {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  width: 100%;
+  padding: 3px 8px;
+  border: none;
+  border-radius: 5px;
+  background: transparent;
+  cursor: pointer;
+  text-align: left;
+  font: var(--text-sm) var(--font-ui);
+  color: var(--color-text);
+}
+.ft-row:hover {
+  background: var(--color-surface);
+}
+.ft-row.active {
+  background: var(--color-surface);
+}
+.ft-chev {
+  flex: none;
+  color: var(--color-text-muted);
+}
+.ft-chev-space {
+  flex: none;
+  width: 16px;
+}
+.ft-ico {
+  flex: none;
+  color: var(--color-text-muted);
+}
+.ft-name {
+  flex: none;
+  max-width: 100%;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.ft-parent {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 11px;
+  color: var(--color-text-muted);
+}
+.ft-git {
+  flex: none;
+  width: 6px;
+  height: 6px;
+  margin-left: auto;
+  border-radius: 50%;
+  background: var(--color-warning, #b58900);
+}
+.ft-spin {
+  flex: none;
+  margin-left: auto;
+}
+
+/* File view ------------------------------------------------------------ */
+.ft-backbar {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 36px;
+  padding: 0 10px;
+  border-bottom: 1px solid var(--color-line);
+  background: var(--color-surface);
+}
+.ft-back {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  border: none;
+  background: transparent;
+  cursor: pointer;
+  padding: 2px 4px;
+  border-radius: 5px;
+  font: var(--text-sm) var(--font-ui);
+  color: var(--color-text-muted);
+}
+.ft-back:hover {
+  background: var(--color-bg);
+  color: var(--color-text);
+}
+.ft-back-icon {
+  transform: rotate(180deg);
+}
+.ft-backpath {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font: var(--text-xs) var(--font-mono);
+  color: var(--color-text-muted);
+}
+.ft-file {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+.ft-file :deep(.file-preview) {
+  flex: 1;
+  min-height: 0;
+}
+</style>
